<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key>
		<string>PSLinkCell</string>
		<key>label</key>
		<string>TeleFocus</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>TeleFocus — Telegram only</string>
			<key>footerText</key>
			<string>Helps Telegram feel lighter on older iPhones. Cannot promise 24h zero lag. Does not delete Telegram features; it reduces UI cost and suspends other user apps while Telegram is open. Author: Kwar Nu</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable TeleFocus</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>freezeOtherApps</string>
			<key>label</key>
			<string>Freeze other apps while in Telegram</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>reduceAnimations</string>
			<key>label</key>
			<string>Reduce animations</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>reduceBlur</string>
			<key>label</key>
			<string>Reduce blur</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>lightChatUI</string>
			<key>label</key>
			<string>Light chat UI (less shadow)</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>aggressiveMemory</string>
			<key>label</key>
			<string>Memory trim in Telegram</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Max FPS inside Telegram</string>
			<key>footerText</key>
			<string>Lower FPS can reduce heat. 60 is smoother; 30 is cooler.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<integer>60</integer>
			<key>defaults</key>
			<string>com.telefocus.tweak</string>
			<key>key</key>
			<string>maxFPS</string>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>30</integer>
				<integer>60</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>Off</string>
				<string>30</string>
				<string>60</string>
			</array>
		</dict>
